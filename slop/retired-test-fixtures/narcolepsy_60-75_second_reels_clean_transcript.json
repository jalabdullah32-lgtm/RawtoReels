        },
        {
          "start": 140.04,
          "end": 148.36,
          "captions": [
            {
              "start": 140.54,
              "end": 142.92,
              "text": "Anyway. If you are falling asleep in"
            },
            {
              "start": 142.92,
              "end": 144.62,
              "text": "conversations, that is not normal."
            },
            {
              "start": 144.62,
              "end": 146.66,
              "text": "Please go get a sleep study."
            },
            {
              "start": 146.66,
              "end": 148.36,
              "text": "That is the whole message."
            }
          ]
        }
      ]
